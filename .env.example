# Copy to .env (never commit .env). All keys are optional.
# FEC: free key from https://api.open.fec.gov/developers/ (DEMO_KEY works with low rate limits)
FEC_API_KEY=
# Census API key (only needed for the optional Census API path; CVAP files need no key)
CENSUS_API_KEY=
# Optional contact string appended to the HTTP User-Agent (Wikipedia API etiquette)
UEI_CONTACT=
